# Blazor WebAssembly Port
BLAZOR_WASM_PORT=5000

# WebAPI Port
WEBAPI_PORT=5001

# API URL for Blazor WebAssembly (used by the frontend to connect to the backend)
API_URL=http://localhost:5001

# PostgreSQL Database
POSTGRES_DB=recht_und_ordnung_db

# JWT Configuration
JWT_KEY=your_jwt_secret_key_minimum_32_characters_long
JWT_ISSUER=webapi
JWT_AUDIENCE=blazor-wasm

# Admin Password (optional, defaults to "password" if not set)
ADMIN_PASSWORD=password
