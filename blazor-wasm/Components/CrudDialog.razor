@typeparam TDto
@using blazor_wasm.Models
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEditMode ? $"{L["Common.Edit"]}: {DialogTitle}" : $"{L["Common.Create"]}: {DialogTitle}")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@Model">
            @FormContent(Model)
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@L["Common.Cancel"]</MudButton>
        <MudButton OnClick="Submit"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <span>@(IsEditMode ? L["Common.Update"].ToString() : L["Common.Create"].ToString())</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public required TDto Model { get; set; }
    [Parameter] public required RenderFragment<TDto> FormContent { get; set; }
    [Parameter] public EventCallback<TDto> OnSubmit { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public string DialogTitle { get; set; } = "Item";

    private MudForm? _form;
    private bool _isSaving;

    private async Task Submit()
    {
        if (_form != null)
        {
            await _form.ValidateAsync();
            if (_form.IsValid)
            {
                _isSaving = true;
                await OnSubmit.InvokeAsync(Model);
                _isSaving = false;
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
