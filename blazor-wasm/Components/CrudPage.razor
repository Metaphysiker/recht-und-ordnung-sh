@typeparam TDto
@typeparam TSearchDto where TSearchDto : SearchDto, new()
@using blazor_wasm.Models
@using blazor_wasm.Services
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L

<CrudSearchList TDto="TDto"
                TSearchDto="TSearchDto"
                @ref="_searchList"
                Title="@Title"
                Service="@Service"
                TableHeaders="@TableHeaders"
                RowTemplate="@RowTemplate"
                SearchFilters="@SearchFilters"
                OnCreateClicked="OpenCreateDialog"
                OnEditClicked="OpenEditDialog"
                OnDeleteClicked="ConfirmDelete"
                CanCreate="@CanCreate"
                CanEdit="@CanEdit"
                CanDelete="@CanDelete"
                PageSize="@PageSize" />

@code {
    [Parameter] public required string Title { get; set; }
    [Parameter] public required CrudService<TDto, TSearchDto> Service { get; set; }
    [Parameter] public required RenderFragment TableHeaders { get; set; }
    [Parameter] public required RenderFragment<TDto> RowTemplate { get; set; }
    [Parameter] public required RenderFragment<TDto> FormContent { get; set; }
    [Parameter] public required Func<TDto> CreateNewInstance { get; set; }
    [Parameter] public required Func<TDto, Guid?> GetId { get; set; }
    [Parameter] public RenderFragment<TSearchDto>? SearchFilters { get; set; }
    [Parameter] public bool CanCreate { get; set; } = true;
    [Parameter] public bool CanEdit { get; set; } = true;
    [Parameter] public bool CanDelete { get; set; } = true;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public string DialogTitle { get; set; } = "Item";

    private CrudSearchList<TDto, TSearchDto>? _searchList;

    private async Task OpenCreateDialog()
    {
        IDialogReference? dialog = null;
        var newItem = CreateNewInstance();
        var parameters = new DialogParameters<CrudDialog<TDto>>
        {
            { x => x.Model, newItem },
            { x => x.FormContent, FormContent },
            { x => x.DialogTitle, DialogTitle },
            { x => x.IsEditMode, false },
            { x => x.OnSubmit, EventCallback.Factory.Create<TDto>(this, async (item) => {
                if (await HandleCreate(item))
                {
                    dialog?.Close();
                    await RefreshList();
                }
            })}
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        dialog = await DialogService.ShowAsync<CrudDialog<TDto>>($"{L["Common.Create"]}: {DialogTitle}", parameters, options);
    }

    private async Task OpenEditDialog(TDto item)
    {
        IDialogReference? dialog = null;
        var parameters = new DialogParameters<CrudDialog<TDto>>
        {
            { x => x.Model, item },
            { x => x.FormContent, FormContent },
            { x => x.DialogTitle, DialogTitle },
            { x => x.IsEditMode, true },
            { x => x.OnSubmit, EventCallback.Factory.Create<TDto>(this, async (updatedItem) => {
                if (await HandleUpdate(updatedItem))
                {
                    dialog?.Close();
                    await RefreshList();
                }
            })}
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        dialog = await DialogService.ShowAsync<CrudDialog<TDto>>($"{L["Common.Edit"]}: {DialogTitle}", parameters, options);
    }

    private async Task ConfirmDelete(TDto item)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", L["Crud.ConfirmDeleteText"].ToString() },
            { "ButtonText", L["Common.Delete"].ToString() },
            { "Color", Color.Error }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<MudMessageBox>(L["Crud.ConfirmDeleteTitle"], parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await HandleDelete(item);
        }
    }

    private async Task<bool> HandleCreate(TDto item)
    {
        var result = await Service.CreateAsync(item);
        if (result != null)
        {
            Snackbar.Add(L["Crud.CreatedSuccess"], Severity.Success);
            return true;
        }
        Snackbar.Add(L["Crud.CreateFailed"], Severity.Error);
        return false;
    }

    private async Task<bool> HandleUpdate(TDto item)
    {
        var id = GetId(item);
        if (id.HasValue)
        {
            var result = await Service.UpdateAsync(id.Value, item);
            if (result != null)
            {
                Snackbar.Add(L["Crud.UpdatedSuccess"], Severity.Success);
                return true;
            }
            Snackbar.Add(L["Crud.UpdateFailed"], Severity.Error);
        }
        return false;
    }

    private async Task HandleDelete(TDto item)
    {
        var id = GetId(item);
        if (id.HasValue)
        {
            var success = await Service.DeleteAsync(id.Value);
            if (success)
            {
                Snackbar.Add(L["Crud.DeletedSuccess"], Severity.Success);
                await RefreshList();
            }
            else
            {
                Snackbar.Add(L["Crud.DeleteFailed"], Severity.Error);
            }
        }
    }

    private async Task RefreshList()
    {
        if (_searchList != null)
        {
            await _searchList.RefreshAsync();
        }
    }
}
