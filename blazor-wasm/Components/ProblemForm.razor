@inject IStringLocalizer<SharedResource> L

<MudTextField @bind-Value="Model.Title"
              Label="@L["Common.Title"]"
              Variant="Variant.Outlined"
              Required="true"
              Class="mb-4" />

<MudTextField @bind-Value="Model.Email"
              Label="@L["Common.Email"]"
              Variant="Variant.Outlined"
              InputType="InputType.Email"
              Class="mb-4" />

<MudTextField @bind-Value="Model.PublicPassword"
              Label="@L["Problem.PublicPassword"]"
              Variant="Variant.Outlined"
              InputType="InputType.Password"
              HelperText="@(Model.HasPublicPassword ? L["Problem.PublicPasswordHintSet"].ToString() : L["Problem.PublicPasswordHintEmpty"].ToString())"
              Class="mb-4" />

<MudText Typo="Typo.subtitle2" Class="mb-1">@L["Common.Description"]</MudText>
<div class="mb-4">
    <RichTextEditor Value="@Model.Description"
                    ValueChanged="@(v => Model.Description = v)" />
</div>

<MudText Typo="Typo.subtitle2" Class="mb-1">
    @L["Problem.Location"]
    <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true"> — @L["Problem.ClickMapHint"]</MudText>
</MudText>

<LeafletMap Coordinates="Model.Coordinates"
            Editable="true"
            Height="280px"
            OnMapClick="AddCoordinate"
            OnMarkerClick="RemoveCoordinate" />

@if (Model.Coordinates.Count > 0)
{
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 mb-1">
        @CoordinateHint
    </MudText>

    <MudSimpleTable Hover="true" Dense="true" Class="mt-2 mb-2">
        <thead>
            <tr>
                <th>@L["Problem.CoordIndex"]</th>
                <th>@L["Problem.CoordLat"]</th>
                <th>@L["Problem.CoordLng"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Coordinates.Count; i++)
            {
                var index = i;
                var coord = Model.Coordinates[index];
                <tr>
                    <td>@(index + 1)</td>
                    <td>@coord.Latitude.ToString("F6")</td>
                    <td>@coord.Longitude.ToString("F6")</td>
                    <td>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => RemoveCoordinate(index))" />
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    <MudButton StartIcon="@Icons.Material.Filled.Clear"
               Size="Size.Small"
               OnClick="ClearCoordinates">
        @L["Common.ClearAll"]
    </MudButton>
}

@code {
    [Parameter] public required ProblemDto Model { get; set; }

    private string CoordinateHint => Model.Coordinates.Count switch
    {
        1 => L["Problem.CoordHintPin"],
        2 => L["Problem.CoordHintLine"],
        _ => L["Problem.CoordHintArea", Model.Coordinates.Count]
    };

    private void AddCoordinate(CoordinateDto coord)
    {
        Model.Coordinates.Add(coord);
        StateHasChanged();
    }

    private void RemoveCoordinate(int index)
    {
        Model.Coordinates.RemoveAt(index);
        StateHasChanged();
    }

    private void ClearCoordinates()
    {
        Model.Coordinates.Clear();
        StateHasChanged();
    }
}
