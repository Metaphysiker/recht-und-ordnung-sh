@inject ProblemService ProblemService
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <CrudSearchList TDto="ProblemDto"
                        TSearchDto="ProblemSearchDto"
                        Title="@L["Problem.PageTitle"]"
                        Service="@ProblemService"
                        TableHeaders="@ProblemTableHeaders"
                        RowTemplate="@ProblemRow"
                        CanCreate="false"
                        CanEdit="false"
                        CanDelete="false"
                        CanSelect="true"
                        OnSelectClicked="OnProblemSelected" />
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private RenderFragment ProblemTableHeaders =>
        @<text>
            <MudTh>@L["Problem.ColTitle"]</MudTh>
            <MudTh>@L["Problem.ColDescription"]</MudTh>
            <MudTh></MudTh>
        </text>;

    private RenderFragment<ProblemDto> ProblemRow => (item) =>
        @<text>
            <MudTd DataLabel="@L["Problem.ColTitle"]">@item.Title</MudTd>
            <MudTd DataLabel="@L["Problem.ColDescription"]">@(item.Description.Length > 50 ? item.Description[..50] + "…" : item.Description)</MudTd>
        </text>;

    private void OnProblemSelected(HashSet<ProblemDto> problems)
    {
        MudDialog.Close(DialogResult.Ok(problems.FirstOrDefault()));
    }
}
