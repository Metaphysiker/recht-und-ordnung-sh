<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="/image-cleaner" Icon="@Icons.Material.Filled.Image">Image Cleaner</MudNavLink>

    <MudDivider Class="my-2" />

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/events" Icon="@Icons.Material.Filled.Event">Events</MudNavLink>
            <MudNavLink Href="/problems" Icon="@Icons.Material.Filled.BugReport">Problems</MudNavLink>

            <MudDivider Class="my-2" />

            <MudNavLink Href="/logout" Icon="@Icons.Material.Filled.Logout">Logout</MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
            <MudNavLink Href="/register" Icon="@Icons.Material.Filled.PersonAdd">Register</MudNavLink>
            <MudNavLink Href="/login2" Icon="@Icons.Material.Filled.Email">Magic Link Login</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>
