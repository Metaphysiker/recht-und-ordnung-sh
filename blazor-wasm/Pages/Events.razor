@page "/events"
@using blazor_wasm.Models
@using blazor_wasm.Services
@using blazor_wasm.Components
@inject EventService EventService
@attribute [Authorize]

<PageTitle>Events</PageTitle>

<CrudPage TDto="EventDto"
          TSearchDto="EventSearchDto"
          Title="Events"
          DialogTitle="Event"
          Service="@EventService"
          CreateNewInstance="@(() => new EventDto())"
          GetId="@(item => item.Id)"
          FormContent="@EventForm"
          TableHeaders="@EventTableHeaders"
          RowTemplate="@EventRow"
          SearchFilters="@EventSearchFilters" />

@code {
    private RenderFragment EventTableHeaders =>
        @<text>
            <MudTh>Title</MudTh>
            <MudTh>Event Date</MudTh>
            <MudTh>Description</MudTh>
            <MudTh Style="text-align: right;">Actions</MudTh>
        </text>;

    private RenderFragment<EventDto> EventRow => (item) =>
        @<text>
            <MudTd DataLabel="Title">@item.Title</MudTd>
            <MudTd DataLabel="Event Date">@item.EventDate.ToString("g")</MudTd>
            <MudTd DataLabel="Description">
                @(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
            </MudTd>
        </text>;

private RenderFragment<EventDto> EventForm => (model) =>
        @<text>
            <MudTextField @bind-Value="model.Title"
                          Label="Title"
                          Variant="Variant.Outlined"
                          Required="true"
                          Class="mb-4" />

            <MudTextField @bind-Value="model.Description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Class="mb-4" />
        </text>;

    private RenderFragment<EventSearchDto> EventSearchFilters => (search) =>
        @<MudStack Row="true" Spacing="2">
            <MudDatePicker @bind-Date="@search.FromDate"
                           Label="From Date"
                           Variant="Variant.Outlined"
                           Clearable="true" />

            <MudDatePicker @bind-Date="@search.ToDate"
                           Label="To Date"
                           Variant="Variant.Outlined"
                           Clearable="true" />
        </MudStack>;
}
