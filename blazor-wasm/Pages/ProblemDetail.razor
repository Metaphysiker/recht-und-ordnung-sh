@page "/problems/{Id:guid}"
@using blazor_wasm.Models
@using blazor_wasm.Services
@using blazor_wasm.Components
@inject ProblemService ProblemService
@inject EventService EventService
@inject IDialogService DialogService
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]

<PageTitle>@(_problem?.Title ?? "Problem Detail")</PageTitle>

<div class="no-print">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("/problems"))">
            @L["Common.Back"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PictureAsPdf"
                   Disabled="_isDownloading"
                   OnClick="DownloadPdfAsync">
            @if (_isDownloading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>@L["Common.Generating"]</span>
            }
            else
            {
                <span>@L["Common.SaveAsPdf"]</span>
            }
        </MudButton>
    </MudStack>
</div>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_problem == null)
{
    <MudAlert Severity="Severity.Error">@L["Problem.NotFound"]</MudAlert>
}
else
{
    <MudText Typo="Typo.h4" GutterBottom="true">@_problem.Title</MudText>
    <div class="mb-4">@((MarkupString)_problem.Description)</div>

    @if (_problem.Coordinates.Count > 0)
    {
        <MudPaper Class="pa-3 mb-4" Elevation="1">
            <LeafletMap Coordinates="_problem.Coordinates" Height="350px" />
        </MudPaper>
    }

    <MudDivider Class="mb-6 no-print" />

    <AttachmentManager ParentId="@Id" ParentType="ParentType.Problem" />

    <MudDivider Class="mb-6 no-print" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h6">@L["Problem.Events"]</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddEventAsync"
                   Class="no-print">
            @L["Problem.AddEvent"]
        </MudButton>
    </MudStack>

    @if (!_events.Any())
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Problem.NoEvents"]</MudText>
    }
    else
    {
        <div class="screen-only">
            <MudTimeline TimelinePosition="TimelinePosition.Left">
                @foreach (var evt in _events)
                {
                    <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                        <ItemContent>
                            <MudPaper Elevation="2" Class="pa-3 mb-2">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@evt.EventDate.ToString("g")</MudText>
                                <MudText Typo="Typo.subtitle1"><strong>@evt.Title</strong></MudText>
                                @if (!string.IsNullOrWhiteSpace(evt.Description))
                                {
                                    <div class="mt-1">@((MarkupString)evt.Description)</div>
                                }
                            </MudPaper>
                        </ItemContent>
                    </MudTimelineItem>
                }
            </MudTimeline>
        </div>

        <div class="print-only">
            <div class="print-timeline">
                @foreach (var evt in _events)
                {
                    <div class="print-timeline-item">
                        <span class="print-timeline-dot"></span>
                        <div class="print-timeline-date">@evt.EventDate.ToString("g")</div>
                        <div class="print-timeline-title">@evt.Title</div>
                        @if (!string.IsNullOrWhiteSpace(evt.Description))
                        {
                            <div class="print-timeline-desc">@((MarkupString)evt.Description)</div>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ProblemDto? _problem;
    private List<EventDto> _events = [];
    private bool _loading = true;
    private bool _isDownloading;

    protected override async Task OnInitializedAsync()
    {
        _problem = await ProblemService.GetByIdAsync(Id);

        var eventResult = await EventService.SearchAsync(new EventSearchDto
        {
            ProblemId = Id,
            PageSize = 1000,
            OrderBy = "EventDate",
            OrderDirection = OrderDirection.Ascending
        });
        _events = eventResult?.Items?.ToList() ?? [];

        _loading = false;
    }

    private async Task AddEventAsync()
    {
        IDialogReference? dialog = null;
        var newEvent = new EventDto { ProblemId = Id };
        var parameters = new DialogParameters<CrudDialog<EventDto>>
        {
            { x => x.Model, newEvent },
            { x => x.FormContent, (model) => @<EventForm Model="model" /> },
            { x => x.DialogTitle, "Event" },
            { x => x.IsEditMode, false },
            { x => x.OnSubmit, EventCallback.Factory.Create<EventDto>(this, async (item) =>
            {
                await EventService.CreateAsync(item);
                dialog?.Close();
                var result = await EventService.SearchAsync(new EventSearchDto
                {
                    ProblemId = Id,
                    PageSize = 1000,
                    OrderBy = "EventDate",
                    OrderDirection = OrderDirection.Ascending
                });
                _events = result?.Items?.ToList() ?? [];
                StateHasChanged();
            })}
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        dialog = await DialogService.ShowAsync<CrudDialog<EventDto>>($"{L["Common.Create"]}: {L["Event.DialogTitle"]}", parameters, options);
    }

    private async Task DownloadPdfAsync()
    {
        _isDownloading = true;
        try
        {
            var response = await Http.GetAsync($"api/Problem/{Id}/pdf");
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var filename = $"{_problem?.Title ?? "problem"}.pdf";
                await JS.InvokeVoidAsync("downloadFile", filename, "application/pdf", bytes);
            }
        }
        finally
        {
            _isDownloading = false;
        }
    }
}
