@page "/problems"
@using blazor_wasm.Models
@using blazor_wasm.Services
@using blazor_wasm.Components
@inject ProblemService ProblemService
@attribute [Authorize]

<PageTitle>Problems</PageTitle>

<CrudPage TDto="ProblemDto"
          TSearchDto="ProblemSearchDto"
          Title="Problems"
          DialogTitle="Problem"
          Service="@ProblemService"
          CreateNewInstance="@(() => new ProblemDto())"
          GetId="@(item => item.Id)"
          FormContent="@ProblemForm"
          TableHeaders="@ProblemTableHeaders"
          RowTemplate="@ProblemRow" />

@code {
    private RenderFragment ProblemTableHeaders =>
        @<text>
            <MudTh>Title</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Events Count</MudTh>
            <MudTh Style="text-align: right;">Actions</MudTh>
        </text>;

    private RenderFragment<ProblemDto> ProblemRow => (item) =>
        @<text>
            <MudTd DataLabel="Title">@item.Title</MudTd>
            <MudTd DataLabel="Description">
                @(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
            </MudTd>
            <MudTd DataLabel="Events Count">@item.EventIds.Count</MudTd>
        </text>;

    private RenderFragment<ProblemDto> ProblemForm => (model) =>
        @<text>
            <MudTextField @bind-Value="model.Title"
                          Label="Title"
                          Variant="Variant.Outlined"
                          Required="true"
                          Class="mb-4" />

            <MudTextField @bind-Value="model.Description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          Lines="5"
                          Class="mb-4" />
        </text>;
}
