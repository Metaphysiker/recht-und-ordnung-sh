@page "/problems"
@using blazor_wasm.Models
@using blazor_wasm.Services
@using blazor_wasm.Components
@inject ProblemService ProblemService
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]

<PageTitle>@L["Problem.PageTitle"]</PageTitle>

<CrudPage TDto="ProblemDto"
          TSearchDto="ProblemSearchDto"
          Title="@L["Problem.PageTitle"]"
          DialogTitle="@L["Problem.DialogTitle"]"
          Service="@ProblemService"
          CreateNewInstance="@(() => new ProblemDto())"
          GetId="@(item => item.Id)"
          FormContent="@ProblemFormContent"
          TableHeaders="@ProblemTableHeaders"
          RowTemplate="@ProblemRow" />

@code {
    private RenderFragment ProblemTableHeaders =>
        @<text>
            <MudTh>@L["Problem.ColTitle"]</MudTh>
            <MudTh>@L["Problem.ColDescription"]</MudTh>
            <MudTh>@L["Problem.ColEventCount"]</MudTh>
            <MudTh Style="text-align: right;">@L["Common.Actions"]</MudTh>
        </text>;

    private RenderFragment<ProblemDto> ProblemRow => (item) =>
        @<text>
            <MudTd DataLabel="@L["Problem.ColTitle"]">
                <MudLink Href="@($"/problems/{item.Id}")">@item.Title</MudLink>
            </MudTd>
            <MudTd DataLabel="@L["Problem.ColDescription"]">
                @(item.Description.Length > 50 ? item.Description[..50] + "…" : item.Description)
            </MudTd>
            <MudTd DataLabel="@L["Problem.ColEventCount"]">@item.EventIds.Count</MudTd>
        </text>;

    private RenderFragment<ProblemDto> ProblemFormContent => (model) =>
        @<ProblemForm Model="model" />;
}
