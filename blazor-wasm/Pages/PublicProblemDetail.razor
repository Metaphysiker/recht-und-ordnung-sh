@page "/public/problems/{Id:guid}"
@layout PublicLayout
@using blazor_wasm.Models
@using blazor_wasm.Layout
@using System.Net
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(_problem?.Title ?? "Problem")</PageTitle>

@if (_state == State.EnteringPassword)
{
    <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-16">
        <MudPaper Class="pa-6" Elevation="3">
            <MudText Typo="Typo.h6" GutterBottom="true">@L["Public.AccessRestricted"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                @L["Public.EnterPasswordHint"]
            </MudText>

            <MudTextField @bind-Value="_password"
                          Label="@L["Public.Password"]"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Error="_wrongPassword"
                          ErrorText="@L["Public.IncorrectPassword"]"
                          Class="mb-4"
                          OnKeyDown="OnKeyDown" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="_unlocking"
                       OnClick="UnlockAsync">
                @if (_unlocking)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @L["Public.Unlock"]
            </MudButton>
        </MudPaper>
    </MudContainer>
}
else if (_state == State.Loaded)
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h4">@_problem!.Title</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PictureAsPdf"
                   Disabled="_isDownloading"
                   OnClick="DownloadPdfAsync">
            @if (_isDownloading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>@L["Common.Generating"]</span>
            }
            else
            {
                <span>@L["Common.SaveAsPdf"]</span>
            }
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_problem.Description))
    {
        <div class="mb-4">@((MarkupString)_problem.Description)</div>
    }

    @if (_problem.Coordinates.Count > 0)
    {
        <MudPaper Class="pa-3 mb-4" Elevation="1">
            <LeafletMap Coordinates="_problem.Coordinates" Height="350px" />
        </MudPaper>
    }

    <MudDivider Class="mb-4" />

    <MudText Typo="Typo.h6" GutterBottom="true">@L["Problem.Events"]</MudText>

    @if (!_events.Any())
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Problem.NoEvents"]</MudText>
    }
    else
    {
        <MudTimeline TimelinePosition="TimelinePosition.Left">
            @foreach (var evt in _events)
            {
                <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                    <ItemContent>
                        <MudPaper Elevation="2" Class="pa-3 mb-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@evt.EventDate.ToString("g")</MudText>
                            <MudText Typo="Typo.subtitle1"><strong>@evt.Title</strong></MudText>
                            @if (!string.IsNullOrWhiteSpace(evt.Description))
                            {
                                <div class="mt-1">@((MarkupString)evt.Description)</div>
                            }
                        </MudPaper>
                    </ItemContent>
                </MudTimelineItem>
            }
        </MudTimeline>
    }
}
else if (_state == State.NotFound)
{
    <MudAlert Severity="Severity.Error">@L["Problem.NotFound"]</MudAlert>
}
else if (_state == State.NotPublic)
{
    <MudAlert Severity="Severity.Warning">@L["Public.NotPublic"]</MudAlert>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private enum State { EnteringPassword, Unlocking, Loaded, NotFound, NotPublic }

    private State _state = State.EnteringPassword;
    private string _password = string.Empty;
    private bool _unlocking;
    private bool _wrongPassword;
    private bool _isDownloading;
    private ProblemDto? _problem;
    private List<EventDto> _events = [];

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await UnlockAsync();
    }

    private async Task UnlockAsync()
    {
        _wrongPassword = false;
        _unlocking = true;

        var response = await Http.PostAsJsonAsync($"api/Problem/{Id}/unlock", new { Password = _password });

        if (response.IsSuccessStatusCode)
        {
            var data = await response.Content.ReadFromJsonAsync<UnlockResponse>();
            _problem = data?.Problem;
            _events = data?.Events ?? [];
            _state = State.Loaded;
        }
        else if (response.StatusCode == HttpStatusCode.NotFound)
        {
            _state = State.NotFound;
        }
        else if (response.StatusCode == HttpStatusCode.Forbidden)
        {
            _state = State.NotPublic;
        }
        else
        {
            _wrongPassword = true;
        }

        _unlocking = false;
    }

    private async Task DownloadPdfAsync()
    {
        _isDownloading = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/Problem/{Id}/pdf-public", new { Password = _password });
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var filename = $"{_problem?.Title ?? "problem"}.pdf";
                await JS.InvokeVoidAsync("downloadFile", filename, "application/pdf", bytes);
            }
        }
        finally
        {
            _isDownloading = false;
        }
    }

    private record UnlockResponse(ProblemDto Problem, List<EventDto> Events);
}
