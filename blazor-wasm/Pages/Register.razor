@page "/register"
@using blazor_wasm.Models
@using blazor_wasm.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">@L["Auth.RegisterTitle"]</MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">@_successMessage</MudAlert>
        }

        <MudForm @ref="_form">
            <MudTextField @bind-Value="_model.Email"
                          Label="@L["Common.Email"]"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="@L["Auth.EmailRequired"]"
                          InputType="InputType.Email"
                          Class="mb-4" />

            <MudTextField @bind-Value="_model.FirstName"
                          Label="@L["Auth.FirstName"]"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="@L["Auth.FirstNameRequired"]"
                          Class="mb-4" />

            <MudTextField @bind-Value="_model.LastName"
                          Label="@L["Auth.LastName"]"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="@L["Auth.LastNameRequired"]"
                          Class="mb-4" />

            <MudTextField @bind-Value="_model.PhoneNumber"
                          Label="@L["Auth.PhoneNumber"]"
                          Variant="Variant.Outlined"
                          InputType="InputType.Telephone"
                          Class="mb-4" />

            <MudTextField @bind-Value="_model.Password"
                          Label="@L["Common.Password"]"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="@L["Auth.PasswordRequired"]"
                          InputType="InputType.Password"
                          HelperText="@L["Auth.PasswordHelp"]"
                          Class="mb-4" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       OnClick="HandleRegister"
                       Disabled="_isLoading"
                       Class="mb-3">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <span>@L["Auth.RegisterTitle"]</span>
                }
            </MudButton>

            <MudText Align="Align.Center">
                @L["Auth.HasAccount"]
                <MudLink Href="/login" Color="Color.Primary">@L["Nav.Login"]</MudLink>
            </MudText>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private RegisterDto _model = new() { Email = "", Password = "", FirstName = "", LastName = "" };
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isLoading;

    private async Task HandleRegister()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var result = await AuthService.RegisterAsync(_model);

            if (result != null)
            {
                _successMessage = L["Auth.RegistrationSuccess"];
                ((CustomAuthStateProvider)AuthStateProvider).NotifyAuthenticationStateChanged();

                await Task.Delay(1500);
                Navigation.NavigateTo("/");
            }
            else
            {
                _errorMessage = L["Auth.RegistrationFailed"];
            }
        }
        catch (Exception ex)
        {
            _errorMessage = L["Auth.RegistrationFailedError", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }
}
